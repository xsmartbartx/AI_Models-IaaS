# Database
DATABASE_URL=postgresql+asyncpg://aifactory:aifactory_secret@postgres:5432/aifactory
DATABASE_URL_SYNC=postgresql://aifactory:aifactory_secret@postgres:5432/aifactory

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI Services
COMFYUI_URL=http://comfyui:8188
OLLAMA_URL=http://ollama:11434

# LLM
LLM_MODEL=qwen2.5:7b

# App
SECRET_KEY=aifactory-secret-key-change-in-production
ENVIRONMENT=development
MEDIA_ROOT=/app/media
NEXT_PUBLIC_API_URL=http://localhost:8000