# Database
DATABASE_URL=postgresql+asyncpg://aifactory:aifactory_secret@postgres:5432/aifactory
DATABASE_URL_SYNC=postgresql://aifactory:aifactory_secret@postgres:5432/aifactory

# Redis / Celery
